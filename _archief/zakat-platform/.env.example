# ─── Database ────────────────────────────────────────────────────────────────
# Local:  docker compose up -d
DATABASE_URL="postgresql://barakah:barakah@localhost:5432/barakah?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional OAuth — omit both to hide the Google button entirely
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── AI (phase 7) ────────────────────────────────────────────────────────────
# "mock" needs no key and is what the test suite uses.
# AI explains calculations; it never produces the amounts and never rules on fiqh.
AI_PROVIDER="mock"                 # anthropic | openai | mock
AI_MODEL="claude-sonnet-5"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ─── Precious metal prices (phase 2) ─────────────────────────────────────────
# "fixture" serves the documented seed prices — deterministic, no key needed.
METAL_PRICE_PROVIDER="fixture"     # fixture | manual | metalprice
METAL_PRICE_API_KEY=""

# ─── Exchange rates (phase 2) ────────────────────────────────────────────────
FX_PROVIDER="fixture"              # fixture | frankfurter
FX_API_KEY=""

# ─── File storage — donation receipts (phase 3) ──────────────────────────────
# Receipts are private; access is always via a short-lived signed URL.
STORAGE_PROVIDER="local"           # local | s3
STORAGE_LOCAL_DIR=".storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ─── Email (phase 5) ─────────────────────────────────────────────────────────
EMAIL_PROVIDER="none"              # none | resend
RESEND_API_KEY=""
EMAIL_FROM="Barakah <no-reply@example.com>"

# ─── Reminder processing (phase 5) ───────────────────────────────────────────
# Shared secret for POST /api/internal/reminders/process, which a cron job or
# queue worker calls. NO SCHEDULER IS CONFIGURED — without one, reminders are
# never processed automatically. Leave empty and the endpoint refuses every
# request; it never falls back to being open.
CRON_SECRET=""

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL="info"                   # debug | info | warn | error
