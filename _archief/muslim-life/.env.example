# ─── Database ────────────────────────────────────────────────────────────────
# Local:  docker compose up -d   (see docs/architecture.md)
# Hosted: Neon / Supabase connection string
DATABASE_URL="postgresql://muslimlife:muslimlife@localhost:5432/muslimlife?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional OAuth providers — omit to hide the buttons entirely
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── AI (Phase 4) ────────────────────────────────────────────────────────────
# Provider: "anthropic" | "openai" | "mock"
# "mock" needs no key and is what the test suite uses.
AI_PROVIDER="mock"
# Fallback model when no provider-specific override is set.
AI_MODEL="claude-sonnet-5"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

OPENAI_API_KEY=""
OPENAI_MODEL=""
# Any OpenAI-compatible endpoint (Azure, Together, Groq, local vLLM).
OPENAI_BASE_URL=""

# Naming a provider without its key is a hard error, not a silent fallback to
# mock. Set this only for a preview/demo deployment that should run on mock.
ALLOW_MOCK_AI_IN_PRODUCTION=""

# ─── Payments ────────────────────────────────────────────────────────────────
# Provider: "stub" | "stripe"
# "stub" needs no credentials and drives the whole billing flow locally.
PAYMENTS_PROVIDER="stub"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Price IDs from your Stripe dashboard. Never hardcoded in the app.
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_YEARLY=""

# Same fail-closed rule as the assistant: stub billing is refused in production
# unless a preview/demo deployment explicitly opts in.
ALLOW_STUB_PAYMENTS_IN_PRODUCTION=""

# ─── Maps (optional) ─────────────────────────────────────────────────────────
# Provider: "none" | "google" | "mapbox" — "none" renders a static placeholder
NEXT_PUBLIC_MAPS_PROVIDER="none"
NEXT_PUBLIC_MAPS_API_KEY=""

# ─── Analytics ───────────────────────────────────────────────────────────────
# "noop" | "console" | "database" | "posthog".
#
# "database" is the default on purpose: events stay in our own Postgres, in the
# same region as everything else, and no third party is contacted unless someone
# deliberately configures one. "console" is refused in production — it would put
# event data into the log stream, which is retained differently and read by more
# people. Naming "posthog" without a key logs a warning once and keeps writing to
# the database, rather than silently dropping events or silently sending them.
ANALYTICS_PROVIDER="database"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ─── Notifications ───────────────────────────────────────────────────────────
# "stub" | "console". There is no live email or push provider yet and neither of
# these pretends otherwise: in-app notifications genuinely work, and the settings
# page tells the member that push and email are not connected. "console" prints
# message bodies and is refused in production.
NOTIFICATIONS_PROVIDER="stub"

# ─── Operations ──────────────────────────────────────────────────────────────
# Extra origins allowed to make state-changing requests, comma-separated, on top
# of NEXT_PUBLIC_APP_URL. Needed when the app answers on more than one hostname
# (apex + www, a preview domain).
ALLOWED_ORIGINS=""

# Shared secret for the detailed /api/ready output and for POST /api/jobs/maintenance
# (which completes due account deletions). Without it the maintenance endpoint
# returns 404 — an unauthenticated endpoint that deletes accounts is not something
# to leave open by default.
HEALTH_CHECK_TOKEN=""
