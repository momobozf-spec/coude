# ─────────────────────────────────────────────────────────────────────────────
#  Parking Guard Brussel — omgevingsvariabelen
#
#  Kopieer naar .env en vul aan. Alles met een waarde hieronder werkt lokaal
#  zonder externe accounts. Alles met LEEG is CONFIGURATION REQUIRED — zie
#  INTEGRATIONS.md voor wat er precies aangevraagd moet worden.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL="http://localhost:3000"

# ── Database ────────────────────────────────────────────────────────────────
# `npm run dev:db` start een echte PostgreSQL op poort 5434 zonder Docker.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/parkingguard?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="vervang-dit-door-een-eigen-secret-van-minstens-32-tekens"

# ── Documentopslag (ADR 0003) ───────────────────────────────────────────────
# "local" = .storage/ op schijf met AES-256-GCM. "s3" = R2/Scaleway/S3.
STORAGE_DRIVER="local"
# Verplicht in ELKE omgeving, ook lokaal. 32 bytes, base64.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_ENCRYPTION_KEY=""
# Hoe lang een signed URL naar een document geldig blijft.
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Alleen nodig als STORAGE_DRIVER="s3" — CONFIGURATION REQUIRED
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Achtergrondtaken (ADR 0002) ─────────────────────────────────────────────
# Leeg = Postgres-driver (werkt overal). Gezet = BullMQ.
REDIS_URL=""

# ── Vision / OCR — CONFIGURATION REQUIRED ───────────────────────────────────
# "anthropic" of "openai". Zonder API-key valt extractie terug op handmatige
# invoer; er wordt nooit stilzwijgend doorgegaan.
EXTRACTION_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Velden onder deze drempel worden in de UI gemarkeerd voor controle.
EXTRACTION_CONFIDENCE_THRESHOLD=90

# ── E-mail — CONFIGURATION REQUIRED ─────────────────────────────────────────
# Leeg = de console-driver logt de mail in plaats van te versturen. Handig
# lokaal, nooit in productie: de env-validatie weigert een lege RESEND_API_KEY
# als NODE_ENV=production.
RESEND_API_KEY=""
MAIL_FROM="Parking Guard <noreply@example.invalid>"
# Het dedicated adres waar gemeenten op antwoorden.
DOSSIER_INBOX="dossiers@example.invalid"
# Secret waarmee de inbound-webhook zijn afzender bewijst.
INBOUND_WEBHOOK_SECRET=""

# ── Betalingen — CONFIGURATION REQUIRED ─────────────────────────────────────
MOLLIE_API_KEY=""
MOLLIE_WEBHOOK_SECRET=""

# ── Observability — optioneel ───────────────────────────────────────────────
SENTRY_DSN=""
LOG_LEVEL="info"

# ── Beleid ──────────────────────────────────────────────────────────────────
# Dagen na afronding waarna brondocumenten automatisch verwijderd worden.
DOCUMENT_RETENTION_DAYS=30
# Een gemeente-entry ouder dan dit wordt automatisch STALE.
MUNICIPALITY_STALE_AFTER_DAYS=180
