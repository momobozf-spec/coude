{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@orbit/types": ["../../packages/types/src/index.ts"],
      "@orbit/types/*": ["../../packages/types/src/*"],
      "@orbit/validation": ["../../packages/validation/src/index.ts"],
      "@orbit/utils": ["../../packages/utils/src/index.ts"],
      "@orbit/core": ["../../packages/core/src/index.ts"],
      "@orbit/ui": ["../../packages/ui/src/index.ts"],
      "@orbit/db": ["../../packages/db/src/index.ts"],
      "@orbit/auth": ["../../packages/auth/src/index.ts"],
      "@orbit/api-core": ["../../packages/api-core/src/index.ts"],
      "@orbit/api-client": ["../../packages/api-client/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
