{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@orbit/types": ["../../packages/types/src/index.ts"],
      "@orbit/types/*": ["../../packages/types/src/*"],
      "@orbit/validation": ["../../packages/validation/src/index.ts"],
      "@orbit/utils": ["../../packages/utils/src/index.ts"],
      "@orbit/core": ["../../packages/core/src/index.ts"],
      "@orbit/ui": ["../../packages/ui/src/index.ts"],
      "@orbit/api-client": ["../../packages/api-client/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
