{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit - ideeen, taken en notities in een centrale omgeving (Android, iOS, Web)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @orbit/web && npm run typecheck --workspace @orbit/mobile",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "dev:web": "npm run dev --workspace @orbit/web",
    "build:web": "npm run build --workspace @orbit/web",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev:mobile": "npm run start --workspace @orbit/mobile",
    "db:local": "npm run local:start --workspace @orbit/db"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.8"
  }
}
