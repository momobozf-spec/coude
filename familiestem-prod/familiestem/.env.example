# Kopieer naar .env op de server en vul alles in. Zet .env NOOIT in git of in een mail.
# De app weigert te starten zolang iets ontbreekt en zegt dan precies wat.

# Domein zonder https:// (Caddy haalt zelf het HTTPS-certificaat op)
FS_DOMAIN=jouwdomein.be
FS_PUBLIC_URL=https://jouwdomein.be

# Toegang tot /ops?key=... — minstens 24 tekens. Maak er een met: openssl rand -hex 24
FS_OPS_KEY=

# Stripe (Dashboard > Developers > API keys en > Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI — sleutel van een project met regio Europa
OPENAI_API_KEY=
OPENAI_BASE_URL=https://eu.api.openai.com/v1
FS_TRANSCRIBE_MODEL=gpt-4o-transcribe

# E-mail via SMTP (bv. Brevo: smtp-relay.brevo.com, poort 587)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Familiestem <hallo@jouwdomein.be>
SUPPORT_EMAIL=hallo@jouwdomein.be
