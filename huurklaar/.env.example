# Publieke URL van de app (zonder slash op het einde)
NEXT_PUBLIC_SITE_URL=https://huurklaar.be

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alleen server-side. Nooit in de browser gebruiken.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers > API keys) — begin met test-sleutels
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Prijs-ID's uit Stripe (Products). Prijzen inclusief 21% btw.
STRIPE_PRICE_DOSSIER=price_...   # €19 eenmalig
STRIPE_PRICE_ZOEKPAS=price_...   # €14,99 per maand

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Limieten advertentie-check
FREE_CHECKS=3
ZOEKPAS_CHECKS_PER_DAY=40

# Snel model voor het uitlezen van meldingsmails
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Inkomende meldingen (Postmark Inbound)
INBOUND_DOMAIN=in.huurklaar.be
INBOUND_MAILBOX=zoek
# Lang en willekeurig (bv. openssl rand -hex 24). Ook invullen in de Postmark webhook-URL.
INBOUND_WEBHOOK_USER=
INBOUND_WEBHOOK_PASSWORD=
INBOUND_MAILS_PER_DAY=30

# Beheerplatform
# Tweestapsverificatie verplicht voor het team (zet alleen lokaal op false om te testen)
ADMIN_REQUIRE_MFA=true
# AI-tarieven in USD per miljoen tokens, formaat model=input:output (komma-gescheiden).
# Vul de ECHTE prijzen in van anthropic.com/pricing. Leeg = AI-kosten worden als onbekend getoond.
AI_PRICES_USD=
# Wisselkoers USD → EUR (bv. van je bank of ECB). Leeg = AI-kosten onbekend.
USD_TO_EUR=
# Btw-tarief voor omzet excl. btw
VAT_RATE_PCT=21
