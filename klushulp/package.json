{
  "name": "klushulp",
  "version": "0.1.0",
  "private": true,
  "description": "Klushulp - lokale marktplaats voor loodgieters, elektriciens en klushulp (werktitel).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:migrate:prod": "tsx --conditions=react-server scripts/migrate.ts",
    "admin:create": "tsx --conditions=react-server scripts/admin-create.ts",
    "demo:seed": "tsx --conditions=react-server scripts/demo-seed.ts",
    "db:seed-catalog": "tsx --conditions=react-server scripts/seed-catalog.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
