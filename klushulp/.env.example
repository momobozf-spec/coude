# --- Database ---
DATABASE_URL=postgres://postgres:lokaal@localhost:54329/klushulp
TEST_DATABASE_URL=postgres://postgres:lokaal@localhost:54329/klushulp_test

# --- Omgeving ---
# Productie: NODE_ENV=production. De app weigert te starten met demo-/testwaarden (src/lib/production-guard.ts).
APP_ENV=

# --- Auth (better-auth) --- genereer: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Platform ---
# Platformkosten per geaccepteerd voorstel, aangerekend aan de dienstverlener (basispunten: 1000 = 10 %).
PLATFORM_FEE_BPS=1000
PLATFORM_FEE_MIN_CENTS=500
# Wettelijke vermeldingen (exploitant). Leeg = enkel bedrijfsnaam.
LEGAL_ENTITY_NAME=Marhaba Cooperation BV
LEGAL_ENTITY_VAT=BE1037222285
LEGAL_ENTITY_ADDRESS=

# --- Uploads ---
STORAGE_DIR=./storage
UPLOAD_MAX_BYTES=5242880

# --- Betalingen (Stripe Connect, testmodus). Leeg = gesimuleerd en zo gemarkeerd. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- E-mail (optioneel; zonder SMTP worden links op het scherm getoond) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Klushulp <noreply@example.invalid>"

# --- AI (optioneel; zonder sleutel werkt de categoriesuggestie op trefwoorden) ---
ANTHROPIC_API_KEY=

# --- Demo (NOOIT in productie) ---
ALLOW_DEMO_DATA=
DEMO_PASSWORD=
