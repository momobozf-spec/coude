{
  "name": "mijn-superrette",
  "private": true,
  "version": "0.1.0",
  "description": "Mijn Superrette \u2014 smart grocery price comparison and shopping assistant for Belgium and the Netherlands",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm --filter @superrette/api test:integration",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @superrette/database migrate",
    "db:generate": "pnpm --filter @superrette/database generate",
    "db:seed:dev": "pnpm --filter @superrette/ingestion seed:dev",
    "dev:api": "pnpm --filter @superrette/api dev",
    "dev:worker": "pnpm --filter @superrette/worker dev",
    "dev:admin": "pnpm --filter @superrette/admin dev",
    "dev:mobile": "pnpm --filter @superrette/mobile start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
