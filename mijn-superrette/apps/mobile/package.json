{
  "name": "@superrette/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Mijn Superrette — iOS & Android app (Expo / React Native)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "build:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@superrette/domain": "workspace:*",
    "@superrette/i18n": "workspace:*",
    "@superrette/shared": "workspace:*",
    "@superrette/ui": "workspace:*",
    "@superrette/validation": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "expo": "~57.0.24",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2"
  }
}
