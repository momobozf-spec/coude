{
  "name": "@superrette/api",
  "version": "0.1.0",
  "private": true,
  "description": "Mijn Superrette backend API (NestJS)",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test:integration": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/platform-socket.io": "^12.0.4",
    "@nestjs/websockets": "^12.0.4",
    "@socket.io/redis-adapter": "^8.3.0",
    "@superrette/alert-engine": "workspace:*",
    "@superrette/basket-engine": "workspace:*",
    "@superrette/database": "workspace:*",
    "@superrette/domain": "workspace:*",
    "@superrette/i18n": "workspace:*",
    "@superrette/ingestion": "workspace:*",
    "@superrette/pricing-engine": "workspace:*",
    "@superrette/product-matching": "workspace:*",
    "@superrette/shared": "workspace:*",
    "@superrette/store-providers": "workspace:*",
    "@superrette/validation": "workspace:*",
    "bullmq": "^6.3.8",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.8.0",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.4",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.3",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.0",
    "unplugin-swc": "^2.0.0"
  }
}
