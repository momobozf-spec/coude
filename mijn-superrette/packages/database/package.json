{
  "name": "@superrette/database",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema (Drizzle), migrations, shared queries and development seed",
  "type": "module",
  "exports": {
    ".": {
      "@superrette/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env dist/migrate.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@superrette/domain": "workspace:*",
    "@superrette/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "@superrette/pricing-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11"
  }
}
