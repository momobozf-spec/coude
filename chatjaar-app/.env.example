# Kopieer naar .env (lokaal) of zet als EAS environment variables. Dit zijn GEEN geheime sleutels.

# Website/backend die de AI-slides maakt (de chatjaar Next.js-app), zonder slash op het einde
EXPO_PUBLIC_API_URL=https://jouwdomein.com
# Optioneel: andere URL voor privacy/voorwaarden (standaard = API_URL)
EXPO_PUBLIC_SITE_URL=

# RevenueCat publieke SDK-sleutels (Project settings > API keys)
EXPO_PUBLIC_RC_IOS_KEY=appl_xxx
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxx

# Consumable in-app product (zelfde id in App Store Connect en Google Play)
EXPO_PUBLIC_UNLOCK_PRODUCT_ID=chatjaar_unlock

# Merknaam (standaard Chatjaar)
EXPO_PUBLIC_BRAND_NAME=
