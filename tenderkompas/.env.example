# --- Database ---
DATABASE_URL=postgres://tk:tk@localhost:5432/tenderkompas
# Supabase (gedeeld project, eigen schema per app):
# DATABASE_URL=postgresql://postgres.gkrlemmsbsxzxpryuasj:[DB-WACHTWOORD]@[POOLER-HOST]:5432/postgres
# DATABASE_SCHEMA=tenderkompas
# Pooler-host kopiëren uit Supabase → Connect → Session pooler; wachtwoord alleen in Render, nooit in git.
# Met DATABASE_SCHEMA migreren via npm run db:migrate:prod (niet drizzle-kit migrate). Leeg = public.
# Aparte database voor tests (wordt bij elke testrun opnieuw gemigreerd)
TEST_DATABASE_URL=postgres://tk:tk@localhost:5432/tenderkompas_test

# --- Omgeving ---
# Productie: NODE_ENV=production. De app WEIGERT te starten met dev-/testwaarden (zie src/lib/production-guard.ts).
# APP_ENV=staging schakelt de guard uit voor een testomgeving.
APP_ENV=

# --- Wettelijke vermeldingen ---
# Zetel van Marhaba Cooperation BV volgens het KBO-register (leeg = deze standaard uit src/lib/legal.ts).
LEGAL_ENTITY_ADDRESS="Sweetstraat 13, 3870 Heers"

# --- Auth (better-auth) ---
# Genereer met: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Productie: https://<jouw-domein>. Eerste beheerder (wordt aangemaakt met `npm run admin:create`)
ADMIN_EMAIL=
ADMIN_NAME=Beheerder

# --- AI-extractie (optioneel; zonder sleutel blijft handmatige analyse beschikbaar) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Prijzen per miljoen tokens in EUR. Controleer de actuele tarieven vóór gebruik;
# leeg laten = kosten worden als "onbekend" geregistreerd (tokens wel).
AI_PRICE_INPUT_EUR_PER_MTOK=
AI_PRICE_OUTPUT_EUR_PER_MTOK=
AI_MAX_INPUT_CHARS=180000

# --- E-mail (optioneel; zonder SMTP enkel preview/export, status "niet ingesteld") ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TenderKompas IT <digest@example.invalid>"
# Enkel voor lokale test-SMTP zonder geldig certificaat
SMTP_ALLOW_SELF_SIGNED=
SMTP_REQUIRE_TLS=

# --- TED ---
TED_API_BASE=https://api.ted.europa.eu
TED_PAGE_LIMIT=100
TED_REQUEST_DELAY_MS=500
# Extra of uit te sluiten velden (kommagescheiden), na `npm run ted:verify-fields`
TED_EXTRA_FIELDS=
TED_EXCLUDE_FIELDS=

# --- Uploads & ophalen ---
STORAGE_DIR=./storage
UPLOAD_MAX_BYTES=20971520
FETCH_MAX_BYTES=20971520
FETCH_TIMEOUT_MS=20000

# --- Bewaartermijnen (dagen) ---
RETENTION_RAW_PAYLOAD_DAYS=365
RETENTION_AUDIT_DAYS=730
RETENTION_LEADS_DAYS=180

# --- Demo (NOOIT in productie) ---
# Demo-scripts (demo:seed, demo:e2e) weigeren zonder ALLOW_DEMO_DATA=true en altijd bij NODE_ENV=production.
ALLOW_DEMO_DATA=
DEMO_PASSWORD=
