# RentGuard Brussels — omgevingsvariabelen
#
# Kopieer naar .env.local en vul in. Zie INTEGRATIONS.md voor wat elke
# integratie doet en wat er zonder werkt.
#
# .env.local staat in .gitignore. Zet hier nooit echte sleutels in.

# ---------------------------------------------------------------------------
# VERPLICHT — zonder deze start de applicatie niet
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Omzeilt RLS. Alleen server-side. Nooit naar de browser.
SUPABASE_SERVICE_ROLE_KEY=

APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Vision-analyse (slijtage vs. schade) — CONFIGURATION REQUIRED
#
# Zonder deze sleutel werkt de uitcheckwizard gewoon, maar zonder AI-analyse:
# de gebruiker classificeert dan zelf. Het vergelijkende rapport werkt in beide
# gevallen. Zie docs/decisions/0004-vision-provider.md.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5
# Onder deze zekerheid wordt een classificatie geforceerd naar UNCLEAR.
VISION_CONFIDENCE_THRESHOLD=0.7

# ---------------------------------------------------------------------------
# Transactionele e-mail — CONFIGURATION REQUIRED
#
# Nodig voor: bevestigingsmails, uitnodiging aan de verhuurder om mee te
# ondertekenen, herinneringen over de waarborgtermijn.
# Dit is GEEN aangetekende zending.
# ---------------------------------------------------------------------------

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Betalingen — CONFIGURATION REQUIRED
#
# Activeer Bancontact naast kaart in het Stripe-dashboard.
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Aangetekende zending — CONFIGURATION REQUIRED
#
# Zonder dit blijft de gratis fallback "verstuur zelf via het bpost-loket"
# beschikbaar; die werkt altijd. Zie docs/decisions/0001.
#
# Verifieer de kwalificatie van de provider op de EU Trusted List
# (https://eidas.ec.europa.eu/efda/tl-browser/) vóór productie — niet op de
# marketingpagina van de provider.
# ---------------------------------------------------------------------------

REGISTERED_MAIL_PROVIDER=none
REGISTERED_MAIL_API_URL=
REGISTERED_MAIL_API_KEY=
REGISTERED_MAIL_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Foutopvolging — CONFIGURATION REQUIRED
# ---------------------------------------------------------------------------

SENTRY_DSN=

# ---------------------------------------------------------------------------
# Cron-endpoints (herinneringen, retentie, verwijderingen)
# Genereer met: openssl rand -hex 32
# ---------------------------------------------------------------------------

CRON_SECRET=
