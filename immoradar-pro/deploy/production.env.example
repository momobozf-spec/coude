# Kopieer op de server naar deploy/.env.production en vul in:
#   cp production.env.example .env.production
# Nooit in git, nooit doorsturen.

# Het domein van de app, zonder https:// (een A-record moet naar de server wijzen)
DOMAIN="app.jouwdomein.be"
# Voor Let's Encrypt (meldingen over het certificaat)
ACME_EMAIL="jij@jouwdomein.be"

# Genereer met:  openssl rand -hex 32   (hex: veilig in een databank-URL)
POSTGRES_PASSWORD=""
SESSION_SECRET=""

# Juridisch: verschijnt op /privacy, /voorwaarden en /verwerkersovereenkomst
LEGAL_ENTITY_NAME="Marhaba Data & AI Agent BV"
LEGAL_ENTITY_VAT="BE 1003.552.102"
LEGAL_ENTITY_MUNICIPALITY="Zaventem"
# VERPLICHT: straat, nr. en postcode van de zetel (de app start anders niet)
LEGAL_ENTITY_ADDRESS=""
LEGAL_CONTACT_EMAIL="momobozf@gmail.com"

# Marktradar blijft uit tot er een legale databron is (LeadRevive only)
FEATURE_MARKET_RADAR="false"

# Leeg laten tijdens de pilot (geen Telegram-meldingen, zie pilotovereenkomst)
TELEGRAM_BOT_TOKEN=""

# Bewaartermijnen (dagen). 0 = uit.
RETENTION_CRM_CONTACT_DAYS="3650"
RETENTION_IMPORT_ROWS_DAYS="90"
BACKUP_KEEP_DAYS="14"
