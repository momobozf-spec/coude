# Supabase: Project Settings -> API (regio Central EU / Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-anon-key

# Publieke URL van de site, zonder slash op het einde (voor login-links en sitemap)
NEXT_PUBLIC_SITE_URL=https://jouwdomein.be

# Bedrijfsgegevens in footer, privacyverklaring en voorwaarden
NEXT_PUBLIC_SITE_NAME=SaaS Overdracht Markt
NEXT_PUBLIC_COMPANY_NAME=Marhaba Data & AI Agent BV
NEXT_PUBLIC_COMPANY_VAT=BE 1003.552.102
# TODO: straat + huisnummer + postcode van de zetel, bv. "Straatnaam 1, 1930 Zaventem" (nu enkel de gemeente)
NEXT_PUBLIC_COMPANY_ADDRESS=Zaventem
NEXT_PUBLIC_CONTACT_EMAIL=momobozf@gmail.com

# Productie-guard: build op Vercel (VERCEL_ENV=production) en `next start` met NODE_ENV=production
# weigeren placeholders hierboven (jouw-project, jouw-anon-key, jouwdomein, localhost, example.com).
