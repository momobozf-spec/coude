# ─────────────────────────────────────────────────────────────
# Layali — omgevingsvariabelen. Kopieer naar .env voor lokaal werk.
# In productie (Render) vul je ze in het dashboard in; zie render.free.yaml.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL="postgresql://layali:layali@localhost:5432/layali"
# Supabase (gedeeld project, eigen schema per app via ?schema=):
# DATABASE_URL="postgresql://postgres.gkrlemmsbsxzxpryuasj:[DB-WACHTWOORD]@[POOLER-HOST]:5432/postgres?schema=layali"
# Pooler-host kopiëren uit Supabase → Connect → Session pooler; wachtwoord alleen in Render, nooit in git.
# Max. verbindingen van de app naar de database.
DATABASE_POOL_MAX=5
# Alleen voor de integratietests (npm test).
TEST_DATABASE_URL="postgresql://layali:layali@localhost:5432/layali_test"

# ── Adres en sessies ─────────────────────────────────────────
# Publiek adres; in productie verplicht https en gelijk aan NEXTAUTH_URL.
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Minstens 32 tekens: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Aantal reverse proxies vóór de app (Render: 1). Bepaalt welk IP de inloglimiet telt.
TRUSTED_PROXY_HOPS=1

# ── Betalingen (Mollie) ──────────────────────────────────────
# test_… voor testen, live_… voor echte betalingen.
MOLLIE_API_KEY=""

# ── E-mail (Resend) ──────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="Layali <noreply@jouwdomein.be>"
# Krijgt de melding van elke nieuwe betaalde bestelling.
ADMIN_EMAIL=""
SUPPORT_EMAIL=""

# ── Verkoper (verplicht op een Belgische webshop) ────────────
# Standaard (src/lib/legal.ts): Marhaba Cooperation BV, BE 1037.222.285,
# Sweetstraat 13, 3870 Heers (zetel volgens het KBO-register), momobozf@gmail.com.
# Overschrijven kan hier.
LEGAL_ENTITY_NAME="Marhaba Cooperation BV"
LEGAL_ENTITY_VAT="BE 1037.222.285"
# Straat + huisnummer + postcode van de maatschappelijke zetel (KBO-register).
LEGAL_ENTITY_ADDRESS="Sweetstraat 13, 3870 Heers"
LEGAL_CONTACT_EMAIL="momobozf@gmail.com"
# Wie betaalt het terugzenden bij herroeping: customer (standaard) of seller.
RETURN_COSTS_PAID_BY=customer
# Zet op 1 nadat een jurist de voorwaarden/privacy/cookie-teksten nagelezen
# heeft: dan verdwijnt de melding "Concept — laten nalezen door een jurist".
LEGAL_TEXTS_REVIEWED=0

# ── Planning ─────────────────────────────────────────────────
# Geheim voor /api/cron/reconcile (min. 32 tekens). Leeg = uit.
CRON_SECRET=""

# ── Eerste beheerder ─────────────────────────────────────────
# npm run bootstrap:admin maakt dit account aan (tijdelijk wachtwoord in de uitvoer).
BOOTSTRAP_ADMIN_EMAIL=""

# ── Optioneel ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Analytics laden pas na toestemming in de cookiebanner. Let op: NEXT_PUBLIC_-
# waarden worden tijdens de build ingebakken.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
# 1 = demo-catalogus laden bij het opstarten (alleen voor een testomgeving).
SEED_DEMO=0
# 1 = dit is een testomgeving: alleen dan start de app in productie met een
# Mollie-testsleutel (test_…) of SEED_DEMO=1. Voor de echte winkel: 0.
STAGING=0
# Marktplaats (verkopers/diensten) — uit tot er echte verkopers zijn.
MARKETPLACE_ENABLED=0
