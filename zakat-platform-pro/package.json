{
  "name": "zakat-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Barakah — Zakat & Charity platform. Calculate Zakat transparently, track Sadaqah, discover accountable charities.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:webpack": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:studio": "prisma studio",
    "verify": "npm run db:validate && npm run typecheck && npm run lint && npm run test",
    "postinstall": "prisma generate",
    "worker": "tsx --conditions=react-server src/worker/index.ts",
    "admin:grant": "tsx --conditions=react-server scripts/grant-admin.ts",
    "unlock:user": "tsx --conditions=react-server scripts/unlock-user.ts",
    "test:e2e": "playwright test",
    "db:reference": "tsx prisma/seed/reference.ts",
    "charity:import": "tsx --conditions=react-server scripts/import-charity.ts",
    "start:render": "prisma migrate deploy && tsx prisma/seed/reference.ts && { [ -z \"$ADMIN_EMAIL\" ] || tsx --conditions=react-server scripts/grant-admin.ts || true; } && exec next start"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.4.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
