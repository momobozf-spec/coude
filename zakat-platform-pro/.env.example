# Barakah — omgevingsvariabelen. Kopieer naar .env en vul in.
# In productie (NODE_ENV=production) weigeren web én worker te starten als de
# verplichte waarden ontbreken; zie src/config/env.ts → productionProblems().

# ─── Database ────────────────────────────────────────────────────────────────
# Lokaal: docker compose up -d   (managed in productie, met sslmode=require)
DATABASE_URL="postgresql://barakah:barakah@localhost:5432/barakah?schema=public"
# Max. verbindingen per proces. Web + worker samen onder de limiet van je database.
DATABASE_POOL_MAX="10"

# ─── Auth ────────────────────────────────────────────────────────────────────
# VERPLICHT. Genereer met: npx auth secret   (of: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_URL="http://localhost:3000"
# VERPLICHT https:// in productie. Wordt ook gebruikt in links in e-mails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optioneel: inloggen met Google. Laat beide leeg om de knop te verbergen.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Inlogbeveiliging. Na LOGIN_MAX_ATTEMPTS foute pogingen gaat een account
# LOGIN_LOCK_MINUTES op slot (daarna telkens het dubbele, max. een dag).
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCK_MINUTES="15"
LOGIN_MAX_ATTEMPTS_PER_IP="30"     # per kwartier, over alle accounts heen
# Aantal reverse proxies vóór de app (Render/Fly/Railway/Caddy: 1). In productie
# minstens 1: de app hoort altijd achter een TLS-proxy te staan.
# Verkeerd ingesteld = de IP-limiet telt het verkeerde adres.
TRUSTED_PROXY_HOPS="1"

# ─── Marktprijzen ────────────────────────────────────────────────────────────
# fixture   = vaste ontwikkelprijzen (NIET in productie; de app weigert te starten)
# published = wat een beheerder publiceert op /admin/prijzen (verplicht in productie)
METAL_PRICE_PROVIDER="fixture"     # fixture | published
FX_PROVIDER="fixture"              # fixture | published
# Ouder dan dit aantal dagen = de berekening weigert in plaats van met een oude nisab te rekenen.
MAX_PRICE_AGE_DAYS="4"
# frankfurter = de worker haalt elk uur de ECB-referentiekoersen op (USD, GBP, TRY).
# MAD, SAR en AED publiceert de ECB niet; die publiceer je zelf.
FX_SYNC="none"                     # none | frankfurter

# ─── Bestandsopslag (donatiebewijzen, jaarrapporten) ─────────────────────────
# local op een PERSISTENT volume. s3 is nog niet geïmplementeerd.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR=".storage"

# ─── E-mail ──────────────────────────────────────────────────────────────────
# VERPLICHT in productie (wachtwoordherstel, herinneringen). Buiten productie
# schrijft "none" de mail (met herstellink) naar de log.
EMAIL_PROVIDER="none"              # none | resend
RESEND_API_KEY=""
EMAIL_FROM="Barakah <no-reply@example.com>"

# ─── Juridisch ───────────────────────────────────────────────────────────────
# Verschijnt op /privacy en /voorwaarden. Zonder contactadres kan niemand zijn
# privacyrechten uitoefenen.
LEGAL_ENTITY_NAME=""
LEGAL_ENTITY_VAT=""
LEGAL_ENTITY_ADDRESS=""
LEGAL_CONTACT_EMAIL=""

# ─── Herinneringen via HTTP (optioneel) ──────────────────────────────────────
# Normaal verwerkt `npm run worker` de herinneringen. Alleen als je platform
# geen worker kan draaien: een cron die POST /api/internal/reminders/process
# aanroept met "Authorization: Bearer <CRON_SECRET>". Leeg = endpoint dicht.
CRON_SECRET=""

# ─── AI (nog niet in gebruik) ────────────────────────────────────────────────
AI_PROVIDER="mock"
AI_MODEL="claude-sonnet-5"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL="info"                   # debug | info | warn | error
