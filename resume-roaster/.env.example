# ── Resume Roaster — environment variables ──────────────────────────
# Copy to .env for local development. Never commit real keys.

# Required in production. The server refuses to start with NODE_ENV=production
# when this is missing or a placeholder.
ANTHROPIC_API_KEY=
# Model id (default: claude-sonnet-5-5, verified in @anthropic-ai/sdk 1.2.0 types).
# Cheaper alternative: claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=1500

# Set to "production" on the host.
NODE_ENV=development
PORT=3001

# Extra browser origins allowed to call /api (comma separated, no trailing slash).
# The app's own origin is always allowed. Example: https://roaster.example.be
ALLOWED_ORIGINS=
# Number of reverse proxies in front of the app (Render/Railway: 1). Needed for a
# correct client IP in the per-IP rate limit. Leave empty when not behind a proxy.
TRUST_PROXY=

# Per-IP limit: RATE_LIMIT_MAX roasts per RATE_LIMIT_WINDOW_MINUTES.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=60
# Global cap on model calls per UTC day (cost guard; in-memory, per instance).
DAILY_ROAST_LIMIT=200

# Upload / input limits
MAX_UPLOAD_MB=5
MAX_RESUME_CHARS=20000

# ── Build-time (frontend, Vite) ──
# TODO: street + number of Marhaba Data & AI Agent BV registered office (Zaventem).
# Shown in the privacy policy / terms. Do not invent an address.
VITE_LEGAL_ENTITY_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=momobozf@gmail.com
