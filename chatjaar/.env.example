# Kopieer naar .env.local (lokaal) of zet in Vercel > Settings > Environment Variables.
# Nooit echte sleutels in git zetten.

# Merknaam op site, slides en in Stripe (standaard Chatjaar). Voor internationaal: een neutrale naam.
NEXT_PUBLIC_BRAND_NAME=

# Publieke URL van de site (zonder slash op het einde)
NEXT_PUBLIC_SITE_URL=https://jouwdomein.be

# Stripe: eerst sk_test_..., daarna sk_live_...
STRIPE_SECRET_KEY=
# Zet op true als je Stripe Tax gebruikt
STRIPE_AUTOMATIC_TAX=false

# Anthropic API-sleutel voor de AI-slides
ANTHROPIC_API_KEY=
# Optioneel: ander model (standaard claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Verplichte bedrijfsgegevens voor colofon, privacy en voorwaarden
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=

# Mobiele app: in-app aankopen controleren via RevenueCat (secret API key v1)
REVENUECAT_SECRET_KEY=
# Optioneel, standaard chatjaar_unlock
REVENUECAT_PRODUCT_ID=
