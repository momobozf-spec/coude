# ── Database ──────────────────────────────────────────────────────────────
# Lokaal: `docker compose up -d` en gebruik onderstaande URL.
# Productie (Render/Neon): plak de connection string van je provider.
DATABASE_URL="postgresql://superette:superette@localhost:5432/superette?schema=public"

# ── Sessie-JWT voor de klant-app (Bearer tokens) ──────────────────────────
JWT_SECRET="vervang-dit-door-32-plus-random-bytes"
JWT_TTL_SECONDS=3600

# ── Gate-token ondertekening (EdDSA / Ed25519) ────────────────────────────
# Genereer met: npm run keys:gen
# De private key ondertekent QR-payloads. De public key verifieert ze.
# Zet in productie ENKEL de public key op de deur-scanner, nooit de private.
GATE_SIGNING_PRIVATE_JWK='{"kty":"OKP","crv":"Ed25519","d":"...","x":"..."}'
GATE_SIGNING_PUBLIC_JWK='{"kty":"OKP","crv":"Ed25519","x":"..."}'

# Levensduur van één QR-code. Kort genoeg dat een screenshot waardeloos is,
# lang genoeg om klokdrift tussen telefoon en scanner op te vangen.
ACCESS_TOKEN_TTL_SECONDS=60
# Hoe vaak de app een nieuwe QR ophaalt. Moet < TTL zijn.
ACCESS_TOKEN_ROTATE_SECONDS=30

# ── IoT / deursturing ─────────────────────────────────────────────────────
MQTT_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
# Zet op "false" om MQTT-publicatie te loggen i.p.v. echt te versturen.
MQTT_ENABLED=true

# ── Betalingen (Mollie — Bancontact, Payconiq, Apple/Google Pay) ──────────
MOLLIE_API_KEY="test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MOLLIE_WEBHOOK_URL="https://jouw-domein.be/api/v1/webhooks/mollie"

# ── Supermarktvergelijker ─────────────────────────────────────────────────
# Map met importbestanden per keten (<adapterkey>.json of .csv), relatief aan apps/api.
# Zie apps/api/data/feeds/README.md voor het formaat.
COMPARE_FEED_DIR="data/feeds"
# Zonder importbestand leveren adapters DEMOGEGEVENS (duidelijk gelabeld in de app).
# Standaard aan buiten productie; in productie altijd uit en niet aan te zetten.
COMPARE_ALLOW_DEMO=true
# Sleutel voor POST /api/v1/compare/internal/sync (header x-job-key). Leeg = endpoint bestaat niet.
# Genereer bv. met: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
COMPARE_JOB_KEY=""
# Na zoveel uur zonder controle toont de app een prijs als "mogelijk verouderd".
COMPARE_PRICE_FRESH_HOURS=48
# Interne planner in de API: elke N minuten importeren + alerts controleren. 0 = uit.
# In productie: 0 in de API en de werker laten draaien (node dist/compare/cli/worker.cli.js),
# die leest dezelfde variabele als interval (standaard 60).
COMPARE_SYNC_INTERVAL_MINUTES=0
# Vorige jobsleutel tijdens een rotatie: beide zijn tijdelijk geldig. Daarna leegmaken.
COMPARE_JOB_KEY_PREVIOUS=""
# Hoe lang één synchronisatie de lease houdt (minuten); een gecrashte run verliest hem daarna.
COMPARE_SYNC_LEASE_MINUTES=20
# Maximale tijd per adapter om een snapshot te leveren (ms); daarna één nieuwe poging.
COMPARE_ADAPTER_TIMEOUT_MS=60000

# ── E-mail (prijsalerts, opt-in per gebruiker) ────────────────────────────
# none = eerlijk overslaan (EMAIL_UNAVAILABLE), file = lokale outbox (JSON per mail),
# http = JSON-API van een provider (Bearer EMAIL_API_KEY, idempotency-key per bericht).
EMAIL_PROVIDER=none
EMAIL_FROM=""
EMAIL_HTTP_URL=""
EMAIL_API_KEY=""
EMAIL_OUTBOX_DIR="data/outbox"
# Pas aan zodra EMAIL_PROVIDER ≠ none; zonder provider weigert de API te starten met true.
NOTIFY_EMAIL_ENABLED=false

# ── Productie: proxy, cookies, sessies, logging ───────────────────────────
# Achter een reverse proxy verplicht (bv. 1 = één hop), anders ziet de rate limiter
# het IP van de proxy voor iedereen. Nooit `true` zonder proxy: dan is X-Forwarded-For spoofbaar.
TRUST_PROXY=false
# Secure-vlag op de sessiecookies van de Superette-app. Standaard aan in productie (niet uit te zetten).
COOKIE_SECURE=
# Cookiedomein, bv. ".superette.be" als app en API op subdomeinen staan. Leeg = host-only.
COOKIE_DOMAIN=""
# Levensduur access-token (cookie, seconden) en sessie (refresh-token, dagen).
WEB_ACCESS_TTL_SECONDS=900
WEB_REFRESH_TTL_DAYS=30
# HSTS alleen als de API via HTTPS wordt aangeboden. Standaard aan in productie.
HSTS_ENABLED=
# json (productie) of pretty (lokaal).
LOG_FORMAT=pretty
# Release-/buildversie, zichtbaar in logs en /health/status.
APP_VERSION=dev
# DSN van een foutmonitoringprovider die het Sentry-envelopeprotocol verstaat
# (Sentry, GlitchTip, Bugsink, self-hosted): https://<publieke sleutel>@<host>/<projectnummer>.
# Leeg = alleen logs. Alleen error/fatal-regels gaan erheen, na redactie, zonder body's,
# headers, e-mailadressen of IP's. Testen: POST /api/v1/health/test-error met x-job-key.
ERROR_REPORTING_DSN=""

# ── Applicatie ────────────────────────────────────────────────────────────
# Origin van de boetiek-PWA (apps/pwa).
APP_URL="http://localhost:3000"
# Origin van de supermarktvergelijker (apps/superette-web). Beide delen deze API.
SUPERETTE_WEB_URL="http://localhost:3001"
# Extra toegestane origins, kommagescheiden (bv. een preview-omgeving). Optioneel.
CORS_ORIGINS=""
API_PORT=4000
NODE_ENV=development

# ── Klant-app (PWA) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Dev-only deurscanner op /simulator/deur. Zonder fysiek kastje kun je de app
# anders niet uitproberen: geen deur, geen winkelmandje, niets te scannen.
#
# LET OP: NEXT_PUBLIC_* wordt bij de build in de browserbundel gebakken.
# Vóór elke deploy: ENABLE op "false" ÉN DEVICE_KEY leeg.
NEXT_PUBLIC_ENABLE_DEV_SCANNER=false
NEXT_PUBLIC_DEV_DEVICE_KEY=""
