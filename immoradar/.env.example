# --- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://immoradar:immoradar@localhost:5432/immoradar"
# Used by integration tests (separate database, will be wiped between tests)
TEST_DATABASE_URL="postgresql://immoradar:immoradar@localhost:5432/immoradar_test"

# --- Application --------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
# 32+ random characters. Used to sign session cookies and hash tokens.
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"
# Secret required by /api/jobs/* endpoints (cron triggers)
CRON_SECRET="change-me-cron-secret"
LOG_LEVEL="info"

# --- Telegram -----------------------------------------------------------------
# Leave empty to use the console transport (messages are logged, not sent).
TELEGRAM_BOT_TOKEN=""

# --- Collectors ---------------------------------------------------------------
# Comma-separated list of enabled collector keys. Fixture collectors are safe.
COLLECTORS_ENABLED="fixture-immo-portal,fixture-private-market"
