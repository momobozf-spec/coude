# Alfred server – copy to .env.alfred (git-ignored) or set in the deployment environment.
# Local development needs only ALFRED_API_TOKEN (or ALFRED_ALLOW_ANONYMOUS=1).

ALFRED_PORT=8787
ALFRED_HOST=0.0.0.0
ALFRED_TIMEZONE=Europe/Brussels
ALFRED_LANGUAGE=nl
ALFRED_USER_NAME=
# Public HTTPS base URL of this server (used for OAuth redirects, e.g. https://alfred.example.com)
ALFRED_PUBLIC_URL=
# Bearer token the app sends; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALFRED_API_TOKEN=
# Local development only – never in production.
ALFRED_ALLOW_ANONYMOUS=0
# Run workers + scheduler inside the API process (1) or as separate processes (0, see npm run worker / scheduler).
ALFRED_EMBEDDED_WORKERS=1
ALFRED_POLL_MS=15000

# ---- Persistence --------------------------------------------------------------------------
# Production: PostgreSQL (UTF-8 database). Without DATABASE_URL the server uses the SQLite file below.
DATABASE_URL=
DATABASE_SSL=0
DATABASE_SCHEMA=
ALFRED_DB_PATH=./data/alfred.db

# ---- Secrets at rest ----------------------------------------------------------------------
# 32-byte key (64 hex chars) that encrypts provider credentials (Gmail refresh tokens) in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it credentials live in memory only and are lost on restart.
ALFRED_SECRET_KEY=

# ---- Cloud AI (optional – everything has a deterministic path) ---------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low
BRAINVOICE_PROXY_URL=
BRAINVOICE_PROXY_TOKEN=

# ---- Mailbox ------------------------------------------------------------------------------
# local (paste/share only), gmail (OAuth, implemented), microsoft-graph (seam only).
ALFRED_EMAIL_PROVIDER=local
# Google Cloud OAuth client (type "Web application"); authorised redirect URI must equal
# ${ALFRED_PUBLIC_URL}/api/auth/gmail/callback (or GMAIL_REDIRECT_URI). Scopes: gmail.modify, userinfo.email.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# ---- HTTPS / hardening --------------------------------------------------------------------
# Either terminate TLS in a reverse proxy (then ALFRED_TRUST_PROXY=1) or give the server a certificate.
ALFRED_TLS_CERT=
ALFRED_TLS_KEY=
ALFRED_TRUST_PROXY=0
ALFRED_RATE_LIMIT_PER_MINUTE=240
# text | json (structured one-line JSON per log entry)
ALFRED_LOG_FORMAT=text
ALFRED_LOG_LEVEL=info

# ---- Home Assistant (REQUIRES EXTERNAL HARDWARE; untested here) ---------------------------
HASS_URL=
HASS_TOKEN=

# ---- Repository for the Software Engineer role (bounded npm scripts only) ------------------
ALFRED_REPO_PATH=

# ---- Expo push notifications to registered devices (REQUIRES DEVICE TEST) ------------------
ALFRED_EXPO_PUSH=1
