# ── Noor Printables — environment variables ─────────────────────────────
# Copy to .env.local for development. NEVER commit real keys.
# In production the app refuses to start when required values are missing or are
# dev/test defaults (see src/lib/env-guard.ts).

# ── Core ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate with: npx auth secret   (min. 32 characters)
AUTH_SECRET=
# Local: file:./prisma/dev.db  — Production (Vercel): libsql://<db>-<org>.turso.io
DATABASE_URL=file:./prisma/dev.db
DATABASE_AUTH_TOKEN=
# Only for a self-hosted server with a persistent disk:
# ALLOW_SQLITE_FILE_IN_PRODUCTION=true

# ── Stripe (Pro / School subscriptions) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_SCHOOL_MONTHLY_PRICE_ID=
STRIPE_SCHOOL_YEARLY_PRICE_ID=
# Set to true after enabling Stripe Tax (EU VAT/OSS) in the Stripe dashboard
STRIPE_AUTOMATIC_TAX=false
# Staging only: allow sk_test_ keys with NODE_ENV=production
# ALLOW_STRIPE_TEST_MODE=true

# ── Displayed prices (must match the Stripe prices; amounts incl. VAT) ──
NEXT_PUBLIC_PRICE_CURRENCY=EUR
NEXT_PUBLIC_PRICE_PRO_MONTHLY=12
NEXT_PUBLIC_PRICE_PRO_YEARLY=97
NEXT_PUBLIC_PRICE_SCHOOL_MONTHLY=49
NEXT_PUBLIC_PRICE_SCHOOL_YEARLY=397
# TODO: amounts are not final. Set to true once confirmed to remove the "te bevestigen" label.
NEXT_PUBLIC_PRICES_CONFIRMED=false

# ── Legal / operator (Marhaba Data & AI Agent BV, BE 1003.552.102, Zaventem) ──
# TODO: street + number of the registered office (do not invent one)
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=momobozf@gmail.com

# ── E-mail (Resend) — optional; without a key mails are only logged (subject only) ──
RESEND_API_KEY=
EMAIL_FROM="Noor Printables <hello@your-verified-domain.be>"
# Receives school invoice requests
ADMIN_EMAIL=momobozf@gmail.com

# ── OAuth (optional). List enabled providers for the login buttons. ──
NEXT_PUBLIC_OAUTH_PROVIDERS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Analytics (optional, only loaded after cookie consent) ──
NEXT_PUBLIC_GA_ID=

# ── Optional modules: OFF unless set to true (rebuild required) ──
NEXT_PUBLIC_FEATURE_MARKETPLACE=false
NEXT_PUBLIC_FEATURE_ACADEMY=false
NEXT_PUBLIC_FEATURE_BOOKS=false
NEXT_PUBLIC_FEATURE_WHITE_LABEL=false
NEXT_PUBLIC_FEATURE_GAMES=false
NEXT_PUBLIC_FEATURE_COMMUNITY=false
NEXT_PUBLIC_FEATURE_RAMADAN_CHALLENGE=false

# Marketplace (only when enabled)
MARKETPLACE_FILE_HOSTS=
MARKETPLACE_FILE_AUTH_HEADER=
DOWNLOAD_TOKEN_SECRET=

# Books / Printful (only when enabled). Register the webhook as
#   https://<domain>/api/webhooks/printful?token=<PRINTFUL_WEBHOOK_SECRET>
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_SECRET=

# Academy / Bunny Stream (only when enabled)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
NEXT_PUBLIC_BUNNY_CDN_URL=

# Community / Circle (only when enabled)
CIRCLE_API_KEY=
CIRCLE_COMMUNITY_ID=
CIRCLE_SUBDOMAIN=
CIRCLE_SSO_SECRET=
NEXT_PUBLIC_CIRCLE_URL=
CIRCLE_SPACE_WELCOME=
CIRCLE_SPACE_WORKSHEETS=
CIRCLE_SPACE_TEACHERS=
CIRCLE_SPACE_REQUESTS=
CIRCLE_SPACE_RAMADAN=
CIRCLE_SPACE_QA=
CIRCLE_SPACE_CELEBRATIONS=
