// Halal Home — datamodel.
//
// Zeven regels die het hele schema sturen. Ze staan hier omdat elke afwijking
// later een migratie op gevulde tabellen kost.
//
//  1. GELDBEDRAGEN ZIJN ALTIJD `Int`, NOOIT `Float`. Float geeft drift zodra we
//     prijshistoriek diffen (450000.0 != 449999.99999) of maandlasten optellen
//     over 300 maanden.
//
//     Er zijn twee eenheden, en de veldnaam zegt altijd welke:
//
//       `...Cents`      — eurocent. Alles wat de gebruiker invoert of wat wij
//                         uitrekenen: budget, eigen middelen, maandlast, totaal.
//       zonder achtervoegsel — hele euro's. Vastgoedprijzen (advertenties
//                         noteren geen centen) en fiscale grondslagen
//                         (registratierechten rekenen op hele euro's).
//
//     Omzetten gebeurt uitsluitend via src/lib/money.ts. Twee eenheden door
//     elkaar halen is een fout van precies factor honderd, en een budget van
//     4.500 € dat als 450.000 € gelezen wordt is geen afrondingsverschil maar
//     een verkeerd huis.
//
//  2. `Property` IS GLOBAAL, NIET PER GEBRUIKER. Eén woning bestaat één keer,
//     ongeacht hoeveel gebruikers hem vinden. De per-gebruiker-relatie zit in
//     `SavedProperty` en `PropertyMatch`.
//
//  3. ALLES VAN EEN GEBRUIKER HANGT AAN EEN `userId`. Ook waar een journeyId al
//     impliciet de gebruiker bepaalt: user isolation moet één WHERE-clausule
//     zijn, niet een join die iemand ooit vergeet.
//
//  4. JSON ALLEEN VOOR DOCUMENTEN, NOOIT VOOR RELATIES OF FILTERVELDEN.
//     `PropertySearch.criteria`, `CostRule.configuration` en
//     `PropertyMatch.reasons` zijn versioneerbare documenten die we nooit
//     relationeel bevragen. Alles waarop we filteren of sorteren staat in een
//     kolom.
//
//  5. FISCALE EN JURIDISCHE REGELS STAAN IN DATA, NIET IN CODE. Registratie-
//     rechten, notariskosten en documentchecklists wijzigen per gewest en per
//     jaar. Ze zitten in `CostRule` en `ChecklistTemplate` met een geldigheids-
//     venster, zodat een wetswijziging een INSERT is en geen release.
//
//  6. ELKE RELIGIEUZE OF FISCALE BEWERING DRAAGT ZIJN HERKOMST MEE. Overal waar
//     het platform iets beweert over shariah-conformiteit of belastingtarieven
//     staan `sourceUrl` en `lastVerifiedAt` verplicht naast de bewering. Zonder
//     bron mag de UI het niet als feit tonen.
//
//  7. GEEN HARDE DELETES OP GEBRUIKERSDATA MET HISTORIEK. Documenten en panden
//     krijgen een status of een `deletedAt`; een favoriet die van de markt is
//     moet zichtbaar blijven.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════════════════════════════════════════
// Enums
// ═════════════════════════════════════════════════════════════════════════════

// ── Journey ──────────────────────────────────────────────────────────────────

/// De fasen van een aankooptraject, in volgorde. De volgorde ÍS de betekenis:
/// de progressieberekening en de "mag ik vooruit"-check leiden af uit de index
/// in deze lijst (zie src/modules/journey/domain/stages.ts).
enum JourneyStage {
  ORIENTATION
  BUDGET
  FINANCING
  PROPERTY_SEARCH
  VIEWINGS
  OFFER
  AGREEMENT
  NOTARY
  INSURANCE_ADMIN
  MOVING
  COMPLETED
}

enum JourneyStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

/// Hoe hard een taakafhankelijkheid is.
///
/// ─── WAAROM DIT ONDERSCHEID BESTAAT ──────────────────────────────────────────
///
/// Niet elke volgorde is even belangrijk. "Bied niet zonder financieringsbewijs"
/// beschermt tegen een schadevergoeding van tienduizenden euro's. "Vergelijk pas
/// financieringsvormen nadat je je behoefte formeel vastlegde" is een nuttige
/// volgorde, maar niemand loopt schade op door het andersom te doen.
///
///   BLOCKING — de latere taak kan niet afgerond worden zolang deze open staat.
///              Alleen voor gevallen waar de omgekeerde volgorde echt schadelijk
///              is.
///   ADVISORY — bepaalt de volgorde in de interface, maar houdt niets tegen.
///
/// Alles blokkerend maken klinkt veiliger maar is het niet: dan raakt een taak
/// die aantoonbaar gedaan is toch niet afgevinkt, en leert de gebruiker dat de
/// vinkjes niet kloppen.
enum TaskDependencyType {
  BLOCKING
  ADVISORY
}

enum JourneyEventType {
  VIEWING
  FINANCING_APPOINTMENT
  NOTARY_APPOINTMENT
  DOCUMENT_DEADLINE
  MOVING
  CUSTOM
}

/// Wat de gebruiker koopt. Bepaalt mede welke checklists gelden: bij nieuwbouw
/// gelden andere attesten en een ander btw-regime dan bij een bestaande woning.
enum PurchaseType {
  EXISTING
  NEW_BUILD
  LAND
  RENOVATION
}

/// Hoe hard de tijdsdruk is. Voedt de standaard-streefdatum en de urgentie van
/// aanbevelingen.
enum PurchaseTimeline {
  ASAP
  WITHIN_3_MONTHS
  WITHIN_6_MONTHS
  WITHIN_12_MONTHS
  NO_DEADLINE
}

/// Waar de gebruiker staat wanneer hij binnenkomt. Bepaalt de startfase van het
/// traject: wie al een woning gevonden heeft, hoort niet bij "oriëntatie" te
/// beginnen en negen fasen te moeten doorklikken.
enum OnboardingGoal {
  ORIENTING
  READY_TO_BUY
  FOUND_PROPERTY
}

/// Waar een gebruiker staat met een financieringsproduct.
///
/// `SELECTED` betekent uitdrukkelijk NIET dat de financiering is goedgekeurd —
/// alleen dat dit de optie is waar de gebruiker mee verder wil. De aanbieder
/// beslist over goedkeuring, niet dit platform.
enum FinancingQuoteStatus {
  DRAFT
  INTERESTED
  SHORTLISTED
  SELECTED
  REJECTED
}

/// Hoe belangrijk een checklist-item is.
///
/// Bewust drie niveaus en geen `required: boolean`: het verschil tussen "de
/// notaris kan zonder dit niet verder" en "dit is verstandig" is precies wat een
/// checklist bruikbaar maakt. Alleen REQUIRED telt mee voor het afronden van een
/// fase.
enum ChecklistImportance {
  REQUIRED
  RECOMMENDED
  OPTIONAL
}

/// Productevents. Bewust een enum en geen vrije string: zo kan er geen
/// eventnaam ontstaan die niemand meer terugvindt, en is de lijst van wat we
/// meten leesbaar op één plek.
enum AnalyticsEventType {
  ONBOARDING_STARTED
  ONBOARDING_STEP_COMPLETED
  ONBOARDING_COMPLETED
  JOURNEY_CREATED
  STAGE_OPENED
  STAGE_COMPLETED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_SKIPPED
  CHECKLIST_ITEM_COMPLETED
  CHECKLIST_ITEM_REOPENED
  RECOMMENDATION_OPENED
  FINANCING_OPENED
  FINANCING_PRODUCT_OPENED
  FINANCING_COMPARISON_CREATED
  FINANCING_CALCULATION_COMPLETED
  FINANCING_QUOTE_SAVED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  DOCUMENT_EXPLANATION_REQUESTED
  NOTARY_OPENED
}

// ── Zoeken & panden ──────────────────────────────────────────────────────────

enum TransactionType {
  BUY
  RENT
}

enum SearchFrequency {
  MANUAL
  DAILY
  EVERY_6_HOURS
  HOURLY
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Levenscyclus van een woning binnen één aankooptraject. Bewust rijker dan
/// "favoriet/afgewezen": het aankoopproces zelf is de reden dat dit platform
/// bestaat, dus de fase van een pand moet erin passen.
enum SavedPropertyStatus {
  SAVED
  SHORTLISTED
  VIEWING_PLANNED
  VISITED
  OFFER_CONSIDERED
  OFFERED
  REJECTED
  PURCHASED
  ARCHIVED
}

// ── Financiering ─────────────────────────────────────────────────────────────

/// De constructies die aanbieders in de markt zetten. Dit enum beschrijft de
/// VORM van het contract, niet het religieuze oordeel — dat staat los in
/// `ShariahAssessmentStatus`.
enum FinancingType {
  MURABAHA
  IJARA
  DIMINISHING_MUSHARAKA
  ISTISNA
  QARD_HASAN
  CONVENTIONAL_MORTGAGE
  OTHER
}

/// Hoe hard de onderbouwing is dat een product als shariah-conform geldt.
///
/// Het platform velt zelf GEEN religieus oordeel. Deze status zegt uitsluitend
/// iets over de herkomst van de bewering:
///
///   CERTIFIED        — een genoemd shariah-orgaan certificeert het product;
///                      `certificationBody` + `certificationUrl` zijn verplicht.
///   PROVIDER_CLAIMED — enkel de aanbieder zelf beweert het; geen derde partij.
///   REVIEWED         — een redacteur van dit platform heeft de publieke
///                      documentatie gelezen en samengevat. Geen fatwa.
///   UNVERIFIED       — bron bekend, maar niet nagelezen.
///   UNKNOWN          — geen informatie. Standaard: het veilige antwoord.
enum ShariahAssessmentStatus {
  CERTIFIED
  PROVIDER_CLAIMED
  REVIEWED
  UNVERIFIED
  UNKNOWN
}

// ── Documenten ───────────────────────────────────────────────────────────────

enum DocumentCategory {
  IDENTITY
  INCOME
  BANK
  FINANCING
  PROPERTY
  OFFER
  PURCHASE_AGREEMENT
  NOTARY
  INSURANCE
  TAX
  OTHER
}

/// De levenscyclus van een document.
///
/// ─── WAAROM PENDING BESTAAT ──────────────────────────────────────────────────
///
/// Een databaserij en een bestand in object storage kunnen niet in één
/// transactie. Er is dus altijd een moment waarop de rij bestaat en het bestand
/// nog niet. Zonder `PENDING` zou zo'n rij er uitzien als een beschikbaar
/// document, en dan krijgt de gebruiker een downloadknop die niets oplevert.
///
///   PENDING    — rij aangemaakt, bestand nog niet (of niet meer) bevestigd.
///   AVAILABLE  — het bestand staat in de opslag en is opvraagbaar.
///   FAILED     — de upload is mislukt. Er is geen bruikbaar bestand.
///   EXPIRED    — `expiresAt` is verstreken; het bestand kan er nog zijn.
///   DELETED    — de gebruiker verwijderde het; het bestand is gewist
///                (`purgedAt`), de rij blijft voor de audittrail.
enum DocumentStatus {
  PENDING
  AVAILABLE
  FAILED
  EXPIRED
  DELETED
}

/// Waar een AI-uitleg vandaan komt.
///
/// `FIXTURE` is geen tweederangs variant: hij bestaat zodat de hele flow zonder
/// credentials te draaien en te testen is, en hij is als zodanig zichtbaar in
/// de UI. Een uitleg die met een fixture is gemaakt, mag nooit doorgaan voor
/// een uitleg van een taalmodel.
enum ExplanationSource {
  FIXTURE
  AI
}

// ── Checklists & begrippen ───────────────────────────────────────────────────

enum ChecklistScope {
  JOURNEY
  DOCUMENTS
  NOTARY
  MOVING
  INSURANCE
}

enum TermCategory {
  REAL_ESTATE
  FINANCING
  NOTARY
  TAX
  INSURANCE
  LEGAL
  ENERGY
}

