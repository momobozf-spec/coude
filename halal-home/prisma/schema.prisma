// ── Account & AI ─────────────────────────────────────────────────────────────

enum UserRole {
  USER
  EDITOR
  ADMIN
}

/// Abonnementen bestaan als enum vanaf dag één zodat feature-gating een
/// vergelijking is en geen migratie. Betalingen zijn nog niet geïmplementeerd.
enum SubscriptionPlan {
  FREE
  PLUS
  PREMIUM
}

enum AiConversationKind {
  JOURNEY_ASSISTANT
  DOCUMENT_EXPLANATION
  PROPERTY_SUMMARY
  TERM_EXPLANATION
}

