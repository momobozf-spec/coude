# ─────────────────────────────────────────────────────────────────────────────
# Halal Home — environment
#
# Kopieer naar `.env` en vul in. `src/config/env.ts` valideert dit bestand bij
# het opstarten: een ontbrekende of onzinnige waarde laat de app falen bij start,
# niet bij de eerste request.
#
# Alleen variabelen die de code daadwerkelijk leest staan hier.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Met docker-compose (zie docker-compose.yml) draait Postgres op poort 5433,
# zodat een lokaal geïnstalleerde Postgres op 5432 niet in de weg zit.
DATABASE_URL=postgresql://halalhome:halalhome@localhost:5433/halalhome?schema=public

# ── Testdatabase ─────────────────────────────────────────────────────────────
# ALLEEN nodig als je de integratietests tegen je eigen Postgres wil draaien.
# Laat hem leeg en `npm run test:integration` start zelf een wegwerpbare
# PostgreSQL 17 op poort 54329 (via embedded-postgres, geen Docker nodig).
#
# Zet hem NOOIT gelijk aan DATABASE_URL. De integratietests schrijven, wissen en
# migreren; op je ontwikkeldatabase betekent dat dataverlies. Een guard in
# tests/integration/database.ts weigert een URL die gelijk is aan DATABASE_URL,
# die een naam als production/prod/live/staging bevat, of die naar een andere
# host dan localhost wijst — maar reken daar niet op als eerste verdediging.
# TEST_DATABASE_URL=postgresql://halalhome_test:halalhome_test@localhost:54329/halalhome_integration?schema=public

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# ── Authentication (Auth.js v5) ──────────────────────────────────────────────
# Genereer met: openssl rand -base64 32
AUTH_SECRET=vervang-dit-door-een-willekeurige-string-van-minstens-32-tekens
# Zet op `true` achter een reverse proxy in productie.
AUTH_TRUST_HOST=true

# ── AI ───────────────────────────────────────────────────────────────────────
# Zet AI_ENABLED=false om zonder API-key te ontwikkelen: elke AI-aanroep geeft
# dan een nette AiDisabledError in plaats van een crash.
AI_ENABLED=false
AI_PROVIDER=anthropic
# Bewust géén default in de code. Een hardcoded modelnaam is een tijdbom: hij
# werkt tot het model uitgefaseerd wordt en breekt dan in productie, ver van de
# plek waar hij staat. De naam hoort hier, en nergens anders.
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_MS=60000
AI_MAX_VALIDATION_RETRIES=1

# ── Storage (documenten) ─────────────────────────────────────────────────────
# local | s3
# `local` schrijft naar STORAGE_LOCAL_DIR, buiten de webroot. Nooit in productie.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.storage
# Maximale uploadgrootte in bytes (10 MB).
STORAGE_MAX_UPLOAD_BYTES=10485760
# Geldigheidsduur van een download-URL, in seconden.
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Sleutel waarmee lokale download-tokens gesigneerd worden. Verplicht wanneer
# STORAGE_PROVIDER=local. Minstens 32 tekens.
STORAGE_SIGNING_SECRET=

# S3-compatibel (AWS S3, Cloudflare R2, Supabase Storage). Verplicht wanneer
# STORAGE_PROVIDER=s3. De bucket MOET privé zijn.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Places / buurt ───────────────────────────────────────────────────────────
# none | fixture | overpass
# `fixture` gebruikt lokale testdata; `overpass` bevraagt OpenStreetMap.
PLACES_PROVIDER=fixture
PLACES_API_KEY=
PLACES_CACHE_TTL_HOURS=168

# ── Vastgoedbronnen ──────────────────────────────────────────────────────────
# Komma-gescheiden. `fixture` is de ingebouwde testbron.
PROPERTY_SOURCES=fixture
PROPERTY_SOURCE_USER_AGENT=HalalHomeBot/0.1 (+https://example.com/contact)
PROPERTY_SOURCE_REQUESTS_PER_MINUTE=20
PROPERTY_SOURCE_TIMEOUT_MS=15000
PROPERTY_SOURCE_MAX_RESULTS_PER_RUN=100

# ── E-mail ───────────────────────────────────────────────────────────────────
# none | resend
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Seed ─────────────────────────────────────────────────────────────────────
SEED_USER_EMAIL=dev@halalhome.local
SEED_USER_PASSWORD=halalhome123
SEED_USER_NAME=Mohamed

# Tweede account, met eigen traject en eigen document. Bestaat om de scheiding
# tussen gebruikers met de hand te kunnen natrekken: log hierop in en probeer
# een document- of download-URL van het eerste account te openen. Je hoort een
# 404 te krijgen.
SEED_SECOND_USER_EMAIL=test@halalhome.local
SEED_SECOND_USER_PASSWORD=halalhome123
SEED_SECOND_USER_NAME=Fatima
