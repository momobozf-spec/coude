# ---------------------------------------------------------------------------
# Halal Product Scanner - environment variables
# Kopieer naar .env en vul in. .env staat in .gitignore.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL. Komt overeen met docker-compose.yml.
DATABASE_URL=postgresql://halal:halal@localhost:5432/halal_scanner?schema=public

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- AI provider ------------------------------------------------------------
# Gebruikt voor ingredient-normalisatie, OCR-opschoning en uitleg-teksten.
# NOOIT voor de definitieve halal-classificatie (die is deterministisch).
# Waarden: anthropic | openai | none
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Storage ----------------------------------------------------------------
# Waarden: local | s3
STORAGE_PROVIDER=local
# Alleen voor STORAGE_PROVIDER=local: map buiten de public webroot.
LOCAL_STORAGE_DIR=./.storage
# Alleen voor STORAGE_PROVIDER=s3 (S3, Cloudflare R2, Supabase Storage, ...)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# --- Auth -------------------------------------------------------------------
# Genereer met: openssl rand -base64 32
AUTH_SECRET=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# --- Externe bronnen --------------------------------------------------------
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
# Open Food Facts vraagt een identificeerbare User-Agent.
OPEN_FOOD_FACTS_USER_AGENT=HalalScanner/0.1 (contact@example.com)
# Hoe lang lokale productdata als vers geldt (uren). 168 = een week.
PRODUCT_SYNC_TTL_HOURS=168
